{
    "info": {
      "name": "UniShare API",
      "description": "Postman collection for testing the UniShare backend API.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Health Check",
        "request": {
          "method": "GET",
          "url": "{{BASE_URL}}"
        }
      },
      {
        "name": "Auth",
        "item": [
          {
            "name": "Register User",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Postman Test\",\n  \"email\": \"{{TEST_EMAIL}}\",\n  \"password\": \"{{TEST_PASSWORD}}\",\n  \"university\": \"Bar-Ilan University\",\n  \"major\": \"Information Science\"\n}"
              },
              "url": "{{BASE_URL}}/api/auth/register"
            }
          },
          {
            "name": "Login User",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{TEST_EMAIL}}\",\n  \"password\": \"{{TEST_PASSWORD}}\"\n}"
              },
              "url": "{{BASE_URL}}/api/auth/login"
            }
          },
          {
            "name": "Get Me",
            "request": {
              "method": "GET",
              "auth": {
                "type": "bearer",
                "bearer": [
                  {
                    "key": "token",
                    "value": "{{TOKEN}}",
                    "type": "string"
                  }
                ]
              },
              "url": "{{BASE_URL}}/api/auth/me"
            }
          },
          {
            "name": "Get Me Without Token",
            "request": {
              "method": "GET",
              "url": "{{BASE_URL}}/api/auth/me"
            }
          }
        ]
      },
      {
        "name": "Summaries",
        "item": [
          {
            "name": "Get All Summaries",
            "request": {
              "method": "GET",
              "url": "{{BASE_URL}}/api/summaries"
            }
          },
          {
            "name": "Get Summary By ID",
            "request": {
              "method": "GET",
              "url": "{{BASE_URL}}/api/summaries/{{SUMMARY_ID}}"
            }
          },
          {
            "name": "Create Summary",
            "request": {
              "method": "POST",
              "auth": {
                "type": "bearer",
                "bearer": [
                  {
                    "key": "token",
                    "value": "{{TOKEN}}",
                    "type": "string"
                  }
                ]
              },
              "body": {
                "mode": "formdata",
                "formdata": [
                  {
                    "key": "courseName",
                    "value": "Postman Test Course",
                    "type": "text"
                  },
                  {
                    "key": "university",
                    "value": "Bar-Ilan University",
                    "type": "text"
                  },
                  {
                    "key": "subject",
                    "value": "Information Science",
                    "type": "text"
                  },
                  {
                    "key": "description",
                    "value": "Summary created for API testing.",
                    "type": "text"
                  },
                  {
                    "key": "file",
                    "type": "file",
                    "src": ""
                  }
                ]
              },
              "url": "{{BASE_URL}}/api/summaries"
            }
          },
          {
            "name": "Update Summary",
            "request": {
              "method": "PUT",
              "auth": {
                "type": "bearer",
                "bearer": [
                  {
                    "key": "token",
                    "value": "{{TOKEN}}",
                    "type": "string"
                  }
                ]
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"courseName\": \"Updated Postman Course\",\n  \"university\": \"Bar-Ilan University\",\n  \"subject\": \"Information Science\",\n  \"description\": \"Updated summary description.\"\n}"
              },
              "url": "{{BASE_URL}}/api/summaries/{{SUMMARY_ID}}"
            }
          },
          {
            "name": "Delete Summary",
            "request": {
              "method": "DELETE",
              "auth": {
                "type": "bearer",
                "bearer": [
                  {
                    "key": "token",
                    "value": "{{TOKEN}}",
                    "type": "string"
                  }
                ]
              },
              "url": "{{BASE_URL}}/api/summaries/{{SUMMARY_ID}}"
            }
          },
          {
            "name": "Get Summary File",
            "request": {
              "method": "GET",
              "url": "{{BASE_URL}}/api/summaries/{{SUMMARY_ID}}/file"
            }
          }
        ]
      }
    ],
    "variable": [
      {
        "key": "BASE_URL",
        "value": "https://unishare-server-1vdq.onrender.com"
      },
      {
        "key": "TOKEN",
        "value": "PASTE_JWT_TOKEN_HERE"
      },
      {
        "key": "SUMMARY_ID",
        "value": "PASTE_SUMMARY_ID_HERE"
      },
      {
        "key": "TEST_EMAIL",
        "value": "postmantest123@example.com"
      },
      {
        "key": "TEST_PASSWORD",
        "value": "CHANGE_ME"
      }
    ]
  }